# .pipeline/verify — idea-to-production build gate (SEED). Deterministic, offline, fast.
# Validates every plugin/marketplace manifest parses + has the required schema shape, and the tracked
# Python compiles. Epic 0001 grows this into a real CI gate. Does NOT touch the marketplace plugins or
# the flow-server/MCP surface.
for f in $(git ls-files '*.claude-plugin/*.json'); do python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$f" || exit 1; done
python3 scripts/ci/check_manifests.py $(git ls-files '*.claude-plugin/*.json') || exit 1
python3 -m py_compile $(git ls-files '*.py')
echo "manifests + python OK"
# Context-routing pre-push gate (deterministic, token-free): reachability + no-dead-routes +
# declared-collisions + lexicon sync. Warn-then-flip checks (phase tags, budget, roadmap tags) only
# WARN until their RFC slices land, so this does not block on unlanded work. See docs/guide/routing-tests.md.
bash scripts/verify-routing.sh || exit 1
bash scripts/routing/route-eval.sh --check || exit 1   # Layer-2 fixture integrity only (no tokens)
# Board-linkage gate (EPIC 0066 / PLAN 0066.002): substantive work must declare a board item (or log a
# [no-board] exemption). --self-test keeps the gate's own logic proven; the live run enforces THIS branch.
bash scripts/verify-board-linkage.sh --self-test || exit 1
bash scripts/verify-board-linkage.sh || exit 1
# Board-first tripwire (EPIC 0066 / PLAN 0066.003): the SessionStart reminder emits the convention + stays inert.
bash .claude/hooks/board-first-reminder.sh --self-test || exit 1
# CLEAR-SAFE covenant injector (EPIC 0071 / PLAN 0071.001): the SessionStart reminder emits the covenant
# (prove-don't-claim the 4 checkpoint proofs + honest fan-out advisement) and stays inert. --self-test
# proves it emits the load-bearing terms + exits 0; the deterministic proof gate is verify-clear-safe.sh (CS2).
bash .claude/hooks/clear-safe-reminder.sh --self-test || exit 1
# CLEAR-SAFE proof gate (EPIC 0071 / PLAN 0071.002 — CS2): the four-proof boundary command. Only its
# --self-test runs here (the pure classifiers + verdict wiring) — the LIVE run is a PLAN/EPIC-BOUNDARY
# command (`bash scripts/verify-clear-safe.sh`), not a pre-push gate: during active work the tree is
# dirty by design, so gating every push on a clean boundary would be wrong. The covenant invokes it live.
bash scripts/verify-clear-safe.sh --self-test >/dev/null || exit 1
# CLEAR-SAFE fan-out advisement (EPIC 0071 / PLAN 0071.003 — CS3): computes whether the next-N board
# items parallelize (Depends-on:/Touches: trailers → wave/held), degrading to serial when unannotated so
# silence never oversells parallelism. Only --self-test runs here (pure classifiers + a full --machine
# fixture run); the live run is a boundary/CS4 call needing the board, not a pre-push gate.
bash scripts/fan-out-advisement.sh --self-test >/dev/null || exit 1
# Vendored GitHub create/link layer (EPIC 0068 / PLAN 0068.002): the pure helpers of gh-pipeline.sh —
# order/marker/title composition + the injection-safe cache accessor. --self-test is hermetic (no gh);
# the live create/link verbs prove themselves against project #4 (the claims harness lands with A8).
bash scripts/roadmap/gh-pipeline.sh --self-test >/dev/null || exit 1
# Context-population injector (EPIC 0067 / PLAN 0067.002): the phase-aware pointer emits KAIZEN + a thin
# ≤60-word pointer; roadmap-routing is phase-gated; safe default when phase is unknown. The always-on
# leanness BUDGET gate (verify-context.sh) lands with PLAN 0067.004.
bash scripts/context/test-phase-pointer.sh || exit 1
# Knowledge-phase resolver (EPIC 0067 / PLAN 0067.003): every knowledge module resolves to a phase
# (own metadata.phase or inherited from referring skills; orphans flagged). --self-test proves the
# resolver logic; the live resolution-coverage gate rides in verify-context.sh (C4) below.
python3 scripts/context/resolve_knowledge_phase.py --self-test || exit 1
# Always-on leanness gate (EPIC 0067 / PLAN 0067.004 — CLOSES EPIC 0067): budgets the phase-independent
# SessionStart injection (KAIZEN + pointer ≤420w), holds the pointer ≤60w, verifies phase-gating stays
# intact, and warns on any unresolved knowledge module. --self-test proves the logic; the live run gates.
bash scripts/verify-context.sh --self-test || exit 1
bash scripts/verify-context.sh --run || exit 1
