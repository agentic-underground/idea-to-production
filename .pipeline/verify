# .pipeline/verify — idea-to-production build gate (SEED). Deterministic, offline, fast.
# Validates every plugin/marketplace manifest parses + has the required schema shape, and the tracked
# Python compiles. Epic 0001 grows this into a real CI gate. Does NOT touch the marketplace plugins or
# the flow-server/MCP surface.
for f in $(git ls-files '*.claude-plugin/*.json'); do python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$f" || exit 1; done
python3 scripts/ci/check_manifests.py $(git ls-files '*.claude-plugin/*.json') || exit 1
python3 -m py_compile $(git ls-files '*.py')
echo "manifests + python OK"
# Context-routing pre-push gate (deterministic, token-free): reachability + no-dead-routes +
# declared-collisions + lexicon sync. Warn-then-flip checks (phase tags, budget, roadmap tags) only
# WARN until their RFC slices land, so this does not block on unlanded work. See docs/guide/routing-tests.md.
bash scripts/verify-routing.sh || exit 1
bash scripts/routing/route-eval.sh --check || exit 1   # Layer-2 fixture integrity only (no tokens)
# Board-linkage gate (EPIC 0066 / PLAN 0066.002): substantive work must declare a board item (or log a
# [no-board] exemption). --self-test keeps the gate's own logic proven; the live run enforces THIS branch.
bash scripts/verify-board-linkage.sh --self-test || exit 1
bash scripts/verify-board-linkage.sh || exit 1
# Board-first tripwire (EPIC 0066 / PLAN 0066.003): the SessionStart reminder emits the convention + stays inert.
bash .claude/hooks/board-first-reminder.sh --self-test || exit 1
# Context-population injector (EPIC 0067 / PLAN 0067.002): the phase-aware pointer emits KAIZEN + a thin
# ≤60-word pointer; roadmap-routing is phase-gated; safe default when phase is unknown. The always-on
# leanness BUDGET gate (verify-context.sh) lands with PLAN 0067.004.
bash scripts/context/test-phase-pointer.sh || exit 1
# Knowledge-phase resolver (EPIC 0067 / PLAN 0067.003): every knowledge module resolves to a phase
# (own metadata.phase or inherited from referring skills; orphans flagged). --self-test proves the
# resolver logic; the live resolution-coverage gate is wired by PLAN 0067.004 (verify-context.sh).
python3 scripts/context/resolve_knowledge_phase.py --self-test || exit 1
